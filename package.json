{
  "name": "artemia-project-frontend",
  "description": "Frontend for the Artemia project, a web application for selling and buying items.",
  "homepage": "https://artemia.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx npm-run-all --parallel dev:next dev:watch-headings",
    "dev:next": "next dev --hostname artemia.local",
    "dev:watch-headings": "nodemon --watch src/content/docs --watch src/scripts --ext mdx,ts --exec \"npm run generate:headings\" --delay 200ms",
    "generate:headings": "tsx src/scripts/generate-docs-toc.ts",
    "generate:headings:force": "tsx src/scripts/generate-docs-toc.ts --force",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "clean": "rm -rf .next"
  },
  "dependencies": {
